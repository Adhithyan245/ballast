# Copy this file to .env and fill in your own keys. .env is git-ignored.
# Claude needs no key: it runs through your Claude subscription via `claude -p`.

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free plan): https://console.groq.com/keys
GROQ_API_KEY=

# Mistral (free Experiment plan, requires opting into data training): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# NVIDIA API catalog (developer access): https://build.nvidia.com -> a model page -> Get API Key
NVIDIA_API_KEY=

# Self-hosted vLLM server on an NVIDIA Brev GPU (docs/BREV_SETUP.md).
# Reach it through a tunnel so it is localhost; the key is the --api-key you start vLLM with.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=
